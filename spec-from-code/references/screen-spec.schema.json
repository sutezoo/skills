{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/screen-spec/v2.json",
  "title": "画面仕様書スキーマ",
  "description": "spec-from-code が出力し、Viewer が表示し、spec-to-test が読み込む、画面仕様書の共有契約。v2.0 で kind の enum 化・種別ごとの記述義務・notApplicable（該当なし）・共通仕様への overrides・画面間参照の正規化を導入した。",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "type",
    "states",
    "events",
    "elements",
    "behaviorMatrix"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0",
      "description": "このスキーマのバージョン。互換性判定に用いる。"
    },
    "id": {
      "type": "string",
      "pattern": "^SCR-[0-9]{3}$",
      "description": "画面の識別子（例: SCR-030）。SCR-数字3桁に固定する。navigation の from/to から参照されるため、全画面で一意にする。"
    },
    "title": {
      "type": "string",
      "description": "画面の名称。"
    },
    "type": {
      "type": "string",
      "enum": [
        "screen"
      ],
      "description": "仕様の種別。現状は画面（screen）のみ。将来の拡張余地として持つ。"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "fixed"
      ],
      "description": "仕様の確定度。draft=生成直後の未レビュー、reviewed=人間が確認済み、fixed=確定。"
    },
    "commonSpec": {
      "type": "string",
      "description": "この画面が暗黙に継承する共通仕様ファイル（common-spec.json）へのパス。プロジェクトに共通仕様がある場合は必ず書く。"
    },
    "overrides": {
      "type": "array",
      "description": "共通仕様からの意図的な逸脱の宣言。逸脱する場合のみ書く。reason が必須なので、意図的な例外と単なる書き揺れを機械的に区別できる。",
      "items": {
        "type": "object",
        "required": ["rule", "behavior", "reason"],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^COM-[0-9]{3}$",
            "description": "逸脱する共通仕様ルールのID（例: COM-002）。共通仕様の rules[].id に実在すること（lint で検査）。"
          },
          "behavior": {
            "type": "string",
            "description": "この画面での実際の振る舞い（共通仕様の代わりに適用される内容）。"
          },
          "reason": {
            "type": "string",
            "description": "逸脱の理由。必須。"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "description": "画面レイアウト。図そのものは持たず、モック画像への参照を持つ。",
      "additionalProperties": false,
      "properties": {
        "mockImage": {
          "type": "string",
          "description": "モック画像のパスまたはファイル名。レイアウトの正はこの画像とする。Figma 等へのリンクでもよい。"
        }
      }
    },
    "navigation": {
      "type": "object",
      "description": "この画面の入口（どこから来るか）と出口（どこへ行くか）。from/to は画面IDに限定する（自由文字列にしない）。これにより全ファイル横断の到達可能性検査と遷移図の自動生成が可能になる。",
      "additionalProperties": false,
      "properties": {
        "entryPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryLink"
          },
          "description": "この画面への遷移元。特定できない場合は空配列にする。"
        },
        "exitPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exitLink"
          },
          "description": "この画面からの遷移先。特定できない場合は空配列にする。"
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "description": "画面が取りうる状態の一覧。",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "状態名。画面内で一意。"
          },
          "description": {
            "type": "string",
            "description": "状態の説明。"
          },
          "initial": {
            "type": "boolean",
            "description": "初期状態であれば true。一覧中ちょうど1つ。"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "description": "画面で起きる生のトリガーの一覧。結果による枝分かれはここに列挙せず、behaviorMatrix の branches で表す。",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "イベント名。画面内で一意。behaviorMatrix から参照される。"
          },
          "description": {
            "type": "string",
            "description": "イベントの説明（何が起きたときか）。"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "画面要素の一覧。単独要素（ページ直下のボタン・入力欄や、グローバルなトーストなど）と、コンテナ（ダイアログのように複数要素をまとめるもの）をトップレベルに混在させる。すべての画面要素を漏れなく挙げる。包括的な『本体』のような器は作らない。",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "behaviorMatrix": {
      "type": "array",
      "description": "状態ごとに、起きうるイベントと処理・遷移先を定義する（状態中心の網羅）。全状態×全イベントのセルを埋める（全域性）。起き得ないセルは notApplicable を理由付きで書く。未記載のセルは lint がエラーにする。",
      "items": {
        "type": "object",
        "required": [
          "state",
          "on"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "description": "対象の状態名。states の name と一致させる。全状態をちょうど1回ずつ挙げる。"
          },
          "on": {
            "type": "array",
            "description": "この状態でのイベントごとの振る舞い。events の全件をちょうど1回ずつカバーする（全域性。lint で検査）。",
            "items": {
              "$ref": "#/$defs/behavior"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entryLink": {
      "type": "object",
      "required": ["from"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^SCR-[0-9]{3}$",
          "description": "遷移元の画面ID。自由文字列にしない。"
        },
        "trigger": {
          "type": "string",
          "description": "遷移が起きる条件・操作。"
        },
        "note": {
          "type": "string",
          "description": "補足。"
        }
      }
    },
    "exitLink": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^SCR-[0-9]{3}$",
          "description": "遷移先の画面ID。自由文字列にしない。"
        },
        "trigger": {
          "type": "string",
          "description": "遷移が起きる条件・操作。"
        },
        "note": {
          "type": "string",
          "description": "補足。"
        }
      }
    },
    "display": {
      "type": "object",
      "required": [
        "visibility"
      ],
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "hidden",
            "visible",
            "operable",
            "conditional"
          ],
          "description": "その状態での見え方。hidden=非表示, visible=表示(操作不可), operable=操作可, conditional=条件付き操作可(conditionに条件文を書く)。表示専用要素は hidden/visible のみを使う。"
        },
        "condition": {
          "type": "string",
          "description": "visibility が conditional のときの条件文（例: 入力内容に変更があるとき）。"
        }
      }
    },
    "behavior": {
      "type": "object",
      "required": [
        "event"
      ],
      "additionalProperties": false,
      "description": "1つの 状態×イベント セルの振る舞い。次の4通りのちょうど1つを取る（排他）: (a) 結果が一通り → process/to、(b) 結果が枝分かれ → branches、(c) 挙動が確定できない → undefined、(d) この状態ではイベントが起き得ない → notApplicable（理由必須）。",
      "oneOf": [
        {
          "anyOf": [
            { "required": ["process"] },
            { "required": ["to"] }
          ],
          "not": {
            "anyOf": [
              { "required": ["branches"] },
              { "required": ["undefined"] },
              { "required": ["notApplicable"] }
            ]
          }
        },
        {
          "required": ["branches"],
          "not": {
            "anyOf": [
              { "required": ["process"] },
              { "required": ["to"] },
              { "required": ["message"] },
              { "required": ["undefined"] },
              { "required": ["notApplicable"] }
            ]
          }
        },
        {
          "required": ["undefined"],
          "not": {
            "anyOf": [
              { "required": ["process"] },
              { "required": ["to"] },
              { "required": ["message"] },
              { "required": ["branches"] },
              { "required": ["notApplicable"] }
            ]
          }
        },
        {
          "required": ["notApplicable"],
          "not": {
            "anyOf": [
              { "required": ["process"] },
              { "required": ["to"] },
              { "required": ["message"] },
              { "required": ["branches"] },
              { "required": ["undefined"] },
              { "required": ["source"] }
            ]
          }
        }
      ],
      "properties": {
        "event": {
          "type": "string",
          "description": "イベント名。events の name と一致させる。"
        },
        "process": {
          "type": [
            "string",
            "null"
          ],
          "description": "実行する処理（外部仕様として記述。内部実装は書かない）。何も起きないことが仕様なら「何もしない」と書く（notApplicable にしない）。"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "description": "遷移先の状態名。状態が変わらないなら自状態、定まらないなら null。"
        },
        "message": {
          "type": "string",
          "description": "この振る舞いで画面に表示するメッセージ。"
        },
        "undefined": {
          "type": "boolean",
          "const": true,
          "description": "この振る舞いがコードからも意図メモ・仕様書からも判断できない未確定箇所。人間の確認に回す。"
        },
        "notApplicable": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "description": "この状態ではこのイベントが発生し得ないことの宣言。『書き忘れ』と区別するための正式な値。発生し得るが何も起きない場合はこれを使わず process「何もしない」で書く。",
          "properties": {
            "reason": {
              "type": "string",
              "description": "発生し得ない根拠（例: この状態では保存ボタンが非表示のため）。必須。"
            }
          }
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "description": "結果による枝分かれ。各分岐が case（条件）と process/to/message または undefined を持つ。",
          "items": {
            "type": "object",
            "required": [
              "case"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "anyOf": [
                  { "required": ["process"] },
                  { "required": ["to"] }
                ],
                "not": { "required": ["undefined"] }
              },
              {
                "required": ["undefined"],
                "not": {
                  "anyOf": [
                    { "required": ["process"] },
                    { "required": ["to"] },
                    { "required": ["message"] }
                  ]
                }
              }
            ],
            "properties": {
              "case": {
                "type": "string",
                "description": "分岐の条件（例: 成功, 更新の競合）。"
              },
              "process": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "その分岐で実行する処理。"
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "その分岐の遷移先の状態名。"
              },
              "message": {
                "type": "string",
                "description": "その分岐で表示するメッセージ。"
              },
              "undefined": {
                "type": "boolean",
                "const": true,
                "description": "true なら未確定の分岐。process/to/message は書かない。"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "description": "このイベントが特定の要素操作で起きる場合の発生源。トップレベル単独要素なら element のみ、コンテナ内要素なら container と element で指す。要素操作によらないイベントでは省略する。",
          "additionalProperties": false,
          "required": [
            "element"
          ],
          "properties": {
            "container": {
              "type": "string",
              "description": "発生源の要素が属するコンテナ名。トップレベルの単独要素を指す場合は省略する。"
            },
            "element": {
              "type": "string",
              "description": "発生源の要素名（コンテナ内で一意）。"
            }
          }
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "テキスト入力",
        "テキストエリア",
        "数値入力",
        "日付入力",
        "選択",
        "チェックボックス",
        "ラジオボタン",
        "ファイル入力",
        "ボタン",
        "リンク",
        "一覧",
        "表示テキスト",
        "画像",
        "バナー",
        "トースト",
        "ダイアログ",
        "パネル"
      ],
      "description": "要素の種別。自由文字列にせず、この enum から選ぶ（用語の揺れを構造的に潰す）。統制するのは分類軸だけで、メッセージ文言などのデータは縛らない。spec-to-test の kind→観点マッピングの引き当てキーになる。"
    },
    "kindDuties": {
      "description": "種別ごとの記述義務。入力欄なのに桁数未定義、一覧なのに0件時挙動なし、といった観点漏れを、画面を書いた時点でバリデーションエラーにする。",
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["テキスト入力", "テキストエリア"] } },
            "required": ["kind"]
          },
          "then": {
            "required": ["constraints", "validations", "displayByState"],
            "properties": { "constraints": { "required": ["maxLength"] } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "数値入力" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["constraints", "validations", "displayByState"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "日付入力" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["validations", "displayByState"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["選択", "チェックボックス", "ラジオボタン", "ファイル入力", "ボタン", "リンク"] } },
            "required": ["kind"]
          },
          "then": {
            "required": ["displayByState"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "一覧" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["emptyBehavior", "displayByState"]
          }
        }
      ]
    },
    "element": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/$defs/kindDuties" }
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "要素名。コンテナ内で一意。これが識別キー。"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "required": {
          "type": "boolean",
          "description": "入力要素が必須なら true。"
        },
        "description": {
          "type": "string",
          "description": "要素の補足説明。"
        },
        "emptyBehavior": {
          "type": "string",
          "minLength": 1,
          "description": "一覧要素でデータが0件のときの表示・挙動（例: 「該当するプロジェクトがありません」と表示する）。kind が一覧のとき必須。"
        },
        "dataRef": {
          "$ref": "#/$defs/dataRef"
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "validations": {
          "$ref": "#/$defs/validations"
        },
        "displayByState": {
          "type": "object",
          "description": "状態ごとの見え方。キーは states の name と一致させる。",
          "additionalProperties": {
            "$ref": "#/$defs/display"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/$defs/kindDuties" }
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "要素名。画面内で一意。これが識別キー。"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "required": {
          "type": "boolean",
          "description": "入力要素が必須なら true。"
        },
        "description": {
          "type": "string",
          "description": "要素の補足説明。"
        },
        "emptyBehavior": {
          "type": "string",
          "minLength": 1,
          "description": "一覧要素でデータが0件のときの表示・挙動。kind が一覧のとき必須。"
        },
        "dataRef": {
          "$ref": "#/$defs/dataRef"
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "validations": {
          "$ref": "#/$defs/validations"
        },
        "displayByState": {
          "type": "object",
          "description": "状態ごとの見え方。キーは states の name と一致させる。",
          "additionalProperties": {
            "$ref": "#/$defs/display"
          }
        },
        "children": {
          "type": "array",
          "description": "このコンテナに属する個別要素。これを持つ項目はコンテナ（ダイアログ・複数要素のまとまり）として扱う。持たない項目は単独要素。",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "description": "トップレベルの画面要素。children を持てばコンテナ、持たなければ単独要素。"
    },
    "dataRef": {
      "type": "object",
      "description": "この要素が読み書きするデータの参照先（テーブル・カラム）。入出力一覧の自動生成に使う。特定できなければ省略する。",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "table": {
          "type": "string",
          "description": "参照先のテーブル（またはリソース）名。"
        },
        "column": {
          "type": "string",
          "description": "参照先のカラム（または属性）名。"
        },
        "note": {
          "type": "string",
          "description": "補足（加工・集計がある場合など）。"
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "入力値の制約。テスト時の境界値はここから算出する。",
      "additionalProperties": true,
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "最小文字数。"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "最大文字数。"
        },
        "format": {
          "type": "string",
          "description": "値の形式（例: email）。"
        },
        "blankOnly": {
          "type": "boolean",
          "description": "空白のみの入力を許すか。false なら許さない。"
        }
      }
    },
    "validations": {
      "type": "array",
      "description": "入力検証。各エントリは「条件」と、その条件に当たったときの「メッセージ」。サーバ側判定（重複など）も区別せず、画面上のエラーの一つとして列挙する。",
      "items": {
        "type": "object",
        "required": [
          "condition",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string",
            "description": "検証に引っかかる条件。"
          },
          "message": {
            "type": "string",
            "description": "条件に当たったとき画面に表示するメッセージ。"
          }
        }
      }
    }
  }
}
