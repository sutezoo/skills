{
  "schemaVersion": "2.0",
  "id": "SCR-030",
  "title": "灯台検索画面",
  "type": "screen",
  "status": "draft",
  "commonSpec": "example.common-spec.json",
  "overrides": [
    {
      "rule": "COM-004",
      "behavior": "検索結果一覧はデータ0件のとき「該当する灯台がありません」と表示する",
      "reason": "検索対象が灯台であることが利用者に分かる文言にするため"
    }
  ],
  "layout": {
    "mockImage": "mocks/SCR-030.png"
  },
  "navigation": {
    "entryPoints": [
      {
        "from": "SCR-010",
        "trigger": "グローバルメニューの「検索」を選択"
      }
    ],
    "exitPoints": [
      {
        "to": "SCR-031",
        "trigger": "検索結果の灯台を選択"
      }
    ]
  },
  "states": [
    {
      "name": "読み込み中",
      "initial": true,
      "description": "画面表示時の初期表示（全件数と検索結果）を取得している"
    },
    {
      "name": "表示中",
      "description": "検索結果と全件数を表示し、フィルタの入力・検索・表示切替ができる"
    },
    {
      "name": "検索中",
      "description": "検索処理の完了を待っている。フィルタ入力と検索は操作できない"
    }
  ],
  "events": [
    {
      "name": "初期表示の取得",
      "description": "画面表示時に全件数と検索結果の初期表示の取得を試みる"
    },
    {
      "name": "フィルタの開閉",
      "description": "開閉ボタンを押す"
    },
    {
      "name": "フィルタ入力の変更",
      "description": "フィルタパネル内のいずれかの入力値が変わる"
    },
    {
      "name": "検索の実行",
      "description": "検索ボタンを押す"
    },
    {
      "name": "検索結果の受信",
      "description": "検索処理の応答が返る"
    },
    {
      "name": "表示切替",
      "description": "表示切替ボタンを押す"
    },
    {
      "name": "検索結果の選択",
      "description": "検索結果一覧のいずれかの灯台を選択する"
    }
  ],
  "elements": [
    {
      "name": "開閉ボタン",
      "kind": "ボタン",
      "description": "フィルタパネルの表示・非表示を切り替える",
      "displayByState": {
        "読み込み中": {
          "visibility": "visible"
        },
        "表示中": {
          "visibility": "operable"
        },
        "検索中": {
          "visibility": "operable"
        }
      }
    },
    {
      "name": "適用中フィルタ表示",
      "kind": "表示テキスト",
      "description": "適用中のフィルタをチップで表示する。適用中フィルタが無いときは何も表示しない",
      "displayByState": {
        "読み込み中": {
          "visibility": "hidden"
        },
        "表示中": {
          "visibility": "visible"
        },
        "検索中": {
          "visibility": "visible"
        }
      }
    },
    {
      "name": "全件数表示",
      "kind": "表示テキスト",
      "description": "検索条件に合致する灯台の全件数を「N件」の形式で表示する",
      "dataRef": {
        "table": "灯台",
        "note": "検索条件に合致する件数の集計"
      },
      "displayByState": {
        "読み込み中": {
          "visibility": "hidden"
        },
        "表示中": {
          "visibility": "visible"
        },
        "検索中": {
          "visibility": "visible"
        }
      }
    },
    {
      "name": "表示切替ボタン",
      "kind": "ボタン",
      "description": "検索結果の表示形式（一覧・カード）を切り替える",
      "displayByState": {
        "読み込み中": {
          "visibility": "visible"
        },
        "表示中": {
          "visibility": "operable"
        },
        "検索中": {
          "visibility": "operable"
        }
      }
    },
    {
      "name": "検索結果一覧",
      "kind": "一覧",
      "description": "検索条件に合致する灯台の一覧。選択で灯台詳細画面に遷移する",
      "emptyBehavior": "データ0件のとき「該当する灯台がありません」と表示する",
      "dataRef": {
        "table": "灯台",
        "note": "検索結果の一覧表示（名前・竣工日など）"
      },
      "displayByState": {
        "読み込み中": {
          "visibility": "hidden"
        },
        "表示中": {
          "visibility": "operable"
        },
        "検索中": {
          "visibility": "visible"
        }
      }
    },
    {
      "name": "フィルタパネル",
      "kind": "パネル",
      "description": "名前や竣工日などのフィルタをまとめる領域。開閉ボタンで表示・非表示を切り替える",
      "displayByState": {
        "読み込み中": {
          "visibility": "visible"
        },
        "表示中": {
          "visibility": "conditional",
          "condition": "開閉ボタンで開いているときのみ"
        },
        "検索中": {
          "visibility": "conditional",
          "condition": "開閉ボタンで開いているときのみ"
        }
      },
      "children": [
        {
          "name": "名前フィルタ",
          "kind": "テキスト入力",
          "description": "灯台の名前による絞り込み。部分一致で検索する",
          "dataRef": {
            "table": "灯台",
            "column": "名前",
            "note": "検索条件（部分一致）"
          },
          "constraints": {
            "maxLength": 100
          },
          "validations": [
            {
              "condition": "100文字を超える",
              "message": "名前は100文字以内で入力してください"
            }
          ],
          "displayByState": {
            "読み込み中": {
              "visibility": "visible"
            },
            "表示中": {
              "visibility": "operable"
            },
            "検索中": {
              "visibility": "visible"
            }
          }
        },
        {
          "name": "竣工日フィルタ",
          "kind": "日付入力",
          "description": "竣工日による絞り込み",
          "dataRef": {
            "table": "灯台",
            "column": "竣工日",
            "note": "検索条件"
          },
          "validations": [
            {
              "condition": "存在しない日付",
              "message": "竣工日は正しい日付で入力してください"
            }
          ],
          "displayByState": {
            "読み込み中": {
              "visibility": "visible"
            },
            "表示中": {
              "visibility": "operable"
            },
            "検索中": {
              "visibility": "visible"
            }
          }
        },
        {
          "name": "検索ボタン",
          "kind": "ボタン",
          "description": "入力したフィルタで検索を実行する",
          "displayByState": {
            "読み込み中": {
              "visibility": "visible"
            },
            "表示中": {
              "visibility": "operable"
            },
            "検索中": {
              "visibility": "visible"
            }
          }
        }
      ]
    }
  ],
  "behaviorMatrix": [
    {
      "state": "読み込み中",
      "on": [
        {
          "event": "初期表示の取得",
          "branches": [
            {
              "case": "成功",
              "process": "全件数と検索結果の初期表示を表示する",
              "to": "表示中"
            },
            {
              "case": "失敗",
              "undefined": true
            }
          ]
        },
        {
          "event": "フィルタの開閉",
          "notApplicable": {
            "reason": "この状態では開閉ボタンが表示のみで押せないため発生しない"
          }
        },
        {
          "event": "フィルタ入力の変更",
          "notApplicable": {
            "reason": "この状態ではフィルタの入力欄が表示のみで編集できないため発生しない"
          }
        },
        {
          "event": "検索の実行",
          "notApplicable": {
            "reason": "この状態では検索ボタンが表示のみで押せないため発生しない"
          }
        },
        {
          "event": "検索結果の受信",
          "notApplicable": {
            "reason": "検索処理が開始されていないため発生しない"
          }
        },
        {
          "event": "表示切替",
          "notApplicable": {
            "reason": "この状態では表示切替ボタンが表示のみで押せないため発生しない"
          }
        },
        {
          "event": "検索結果の選択",
          "notApplicable": {
            "reason": "この状態では検索結果一覧が非表示のため発生しない"
          }
        }
      ]
    },
    {
      "state": "表示中",
      "on": [
        {
          "event": "初期表示の取得",
          "notApplicable": {
            "reason": "初期表示の取得は画面表示時（読み込み中）にのみ行われるため発生しない"
          }
        },
        {
          "event": "フィルタの開閉",
          "process": "フィルタパネルの表示・非表示を切り替える",
          "to": "表示中",
          "source": {
            "element": "開閉ボタン"
          }
        },
        {
          "event": "フィルタ入力の変更",
          "process": "入力値を検索条件として保持する。検索はまだ実行しない",
          "to": "表示中",
          "source": {
            "container": "フィルタパネル",
            "element": "名前フィルタ"
          }
        },
        {
          "event": "検索の実行",
          "branches": [
            {
              "case": "入力検証エラーあり",
              "process": "該当要素にエラーを表示し、状態を変えない",
              "to": "表示中"
            },
            {
              "case": "入力検証エラーなし",
              "process": "検索を開始し、適用中のフィルタをチップで表示する",
              "to": "検索中"
            }
          ],
          "source": {
            "container": "フィルタパネル",
            "element": "検索ボタン"
          }
        },
        {
          "event": "検索結果の受信",
          "notApplicable": {
            "reason": "検索処理が開始されていないため発生しない"
          }
        },
        {
          "event": "表示切替",
          "process": "検索結果の表示形式（一覧・カード）を切り替える。検索条件と結果は変えない",
          "to": "表示中",
          "source": {
            "element": "表示切替ボタン"
          }
        },
        {
          "event": "検索結果の選択",
          "process": "選択した灯台の詳細画面に遷移する",
          "to": null,
          "source": {
            "element": "検索結果一覧"
          }
        }
      ]
    },
    {
      "state": "検索中",
      "on": [
        {
          "event": "初期表示の取得",
          "notApplicable": {
            "reason": "初期表示の取得は画面表示時（読み込み中）にのみ行われるため発生しない"
          }
        },
        {
          "event": "フィルタの開閉",
          "process": "フィルタパネルの表示・非表示を切り替える。実行中の検索には影響しない",
          "to": "検索中",
          "source": {
            "element": "開閉ボタン"
          }
        },
        {
          "event": "フィルタ入力の変更",
          "notApplicable": {
            "reason": "この状態ではフィルタの入力欄が表示のみで編集できないため発生しない"
          }
        },
        {
          "event": "検索の実行",
          "notApplicable": {
            "reason": "この状態では検索ボタンが表示のみで押せないため発生しない（二重実行の防止）"
          }
        },
        {
          "event": "検索結果の受信",
          "branches": [
            {
              "case": "成功",
              "process": "検索結果一覧と全件数を更新する",
              "to": "表示中"
            },
            {
              "case": "失敗",
              "process": "エラーを通知する",
              "to": "表示中",
              "message": "検索に失敗しました。時間をおいて再試行してください"
            }
          ]
        },
        {
          "event": "表示切替",
          "undefined": true,
          "source": {
            "element": "表示切替ボタン"
          }
        },
        {
          "event": "検索結果の選択",
          "notApplicable": {
            "reason": "この状態では検索結果一覧が表示のみで選択できないため発生しない"
          }
        }
      ]
    }
  ]
}
