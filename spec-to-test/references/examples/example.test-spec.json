        { "id": "EC-I10", "kind": "invalid", "condition": "500文字を超える", "expected": "自己紹介は500文字以内で入力してください" },
        { "id": "EC-I11", "kind": "invalid", "condition": "改行・絵文字を多数含む長文", "expected": "保存・表示・カウントが壊れない（長文レイアウト）", "catalogId": "H-DISP-03" }
