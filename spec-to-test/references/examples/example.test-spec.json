  "decisionTables": [
    {
      "viewpoint": "T04",
      "name": "保存中での保存結果の受信",
      "conditions": ["結果"],
      "rules": [
        { "id": "R1", "values": { "成功": "T" }, "actions": ["保存完了を通知する", "→ 保存完了"], "message": "保存しました" },
        { "id": "R2", "values": { "入力検証エラー": "T" }, "actions": ["該当要素にエラーを表示する", "→ 編集可能"] },
        { "id": "R3", "values": { "更新の競合": "T" }, "actions": ["競合を通知し最新取得を促す", "→ 競合"], "message": "他の端末で更新されています。最新の内容を取得してください" },
        { "id": "R4", "values": { "その他の失敗": "T" }, "actions": ["画面上部にエラーを通知する", "→ 編集可能"], "message": "保存に失敗しました。時間をおいて再試行してください" },
        { "id": "R5", "values": { "通信の失敗": "T" }, "actions": ["画面上部にエラーを通知する", "→ 編集可能"], "message": "通信に失敗しました。時間をおいて再試行してください" }
      ]
    }
  ],
  "stateTransitions": [
    {
      "viewpoint": "T05",
      "transitions": [
        { "id": "TR01", "from": "読み込み中", "event": "初期値の取得", "to": "編集可能", "process": "取得した値を各入力欄に表示する", "note": "成功時" },
