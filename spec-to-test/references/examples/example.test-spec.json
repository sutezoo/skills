    { "target": "検索ボタン", "kind": "ボタン", "catalogId": "COM-003", "status": "applied", "coveredBy": "T09 / T06-検索ボタン-検索中" },
    { "target": "検索結果一覧", "kind": "一覧", "catalogId": "COM-004", "status": "applied", "coveredBy": "T07（overrides 宣言により「該当する灯台がありません」が期待値）" },
