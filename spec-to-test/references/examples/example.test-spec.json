        { "id": "EC-I08", "kind": "invalid", "condition": "他の利用者と重複している", "expected": "このメールアドレスは既に使用されています" },
        { "id": "EC-I09", "kind": "invalid", "condition": "絵文字・全角英数を含む", "expected": "形式エラー。文字種で壊れない", "catalogId": "H-I18N-01" }
      ]
