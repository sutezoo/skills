        { "id": "TR04", "from": "編集可能", "event": "保存の実行", "to": "編集可能", "process": "該当要素にエラーを表示", "note": "入力検証エラーあり" },
        { "id": "TR05", "from": "保存中", "event": "保存結果の受信", "to": "保存完了", "process": "完了通知", "note": "成功" },
